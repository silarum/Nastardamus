BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
WEB_APP_URL=https://nastardamus.vercel.app

# OpenAI is the primary provider. OpenRouter remains an optional fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash:free
OPENROUTER_VISION_MODEL=openrouter/free
AI_PROVIDER_ALLOWED_HOSTS=

# Admin bot and access control.
ADMIN_BOT_TOKEN=
ADMIN_WEBHOOK_SECRET=
ADMIN_TELEGRAM_IDS=
ADMIN_STORE_URL=

# Server-backed SILARUM wallet.
USER_STORE_URL=

# Preview only. Ignored automatically in Vercel/Node production.
ALLOW_UNAUTHENTICATED_PREVIEW=false

