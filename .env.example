BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
WEB_APP_URL=https://nastardamus.vercel.app

# DeepSeek handles every final text response. Point the base URL at the
# transparent proxy when used locally (for example http://127.0.0.1:19100)
# or at its public HTTPS address in production.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Vision runs only for requests that contain photos. The endpoint must be
# OpenAI-compatible and support /chat/completions with image_url content.
VISION_API_KEY=
VISION_BASE_URL=https://openrouter.ai/api/v1
VISION_MODEL=

# Optional legacy Vision fallback and supplementary image moderation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Optional providers for custom agents configured through the AI center.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash:free
# Optional override. With OPENROUTER_API_KEY, Vision defaults to openrouter/free.
OPENROUTER_VISION_MODEL=openrouter/free
AI_PROVIDER_ALLOWED_HOSTS=

# Admin bot and access control.
ADMIN_BOT_TOKEN=
ADMIN_WEBHOOK_SECRET=
ADMIN_TELEGRAM_IDS=
ADMIN_STORE_URL=

# Server-backed SILARUM wallet.
USER_STORE_URL=

# Preview only. Ignored automatically in Vercel/Node production.
ALLOW_UNAUTHENTICATED_PREVIEW=false

# Edge Function settings are configured in Supabase secrets.
# NASTARDAMUS_APP_BOT_ID=
# NASTARDAMUS_ADMIN_BOT_ID=
# NASTARDAMUS_ALLOWED_ORIGIN=https://nastardamus.vercel.app
# NASTARDAMUS_ENCRYPTION_SECRET=
# NASTARDAMUS_AI_PROVIDER_HOSTS=
